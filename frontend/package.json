{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "api:generate": "orval --config orval.config.ts",
    "test": "vitest run",
    "test:api": "vitest run tests/api",
    "typecheck:api": "tsc --project tsconfig.api.json",
    "postinstall": "patch-package",
    "format": "biome format src --write",
    "lint": "biome check src --diagnostic-level=error"
  },
  "dependencies": {
    "@asouei/safe-fetch": "^1.0.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@lucide/vue": "^1.53.0",
    "@pinia/colada": "^1.4.8",
    "@tailwindcss/vite": "^4.3.3",
    "@vueuse/core": "^15.0.0",
    "dompurify": "^3.4.16",
    "marked": "^18.1.0",
    "mitt": "^3.0.1",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "temporal-polyfill": "^1.0.5",
    "vite": "8.3.5",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.13",
    "vue-router": "^5.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "24.13.2",
    "@vicons/fa": "^0.13.0",
    "@vicons/utils": "^0.1.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/devtools-api": "^8.2.1",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.6.1",
    "naive-ui": "^2.45.3",
    "orval": "^8.41.0",
    "patch-package": "^8.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.5",
    "vue-tsc": "3.3.11"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.6"
  }
}
